# Your deployed address, used for SEO tags, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: a Formspree form URL (https://formspree.io/f/xxxxxxx) so the
# contact form delivers messages to your inbox. Leave unset and the form
# opens the visitor's email app instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=
